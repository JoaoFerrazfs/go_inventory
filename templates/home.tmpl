<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Go Inventory</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="flex flex-col min-h-screen bg-gray-100 font-sans">

    <!-- Header -->
    <header class="flex justify-between items-center bg-blue-900 text-white px-4 py-3">
        <div class="text-2xl font-bold">Go Inventory</div>
        <img src="/static/img/logo2.png" alt="Logo" class="h-12 md:h-14 object-contain">
    </header>

    <!-- Hero Section -->
    <section class="flex flex-col items-center text-center flex-1 px-4 pt-24 md:pt-32">
        <h1 class="text-3xl md:text-4xl font-bold text-blue-900 mb-4">Bem-vindo ao Go Inventory</h1>
        <p class="text-gray-600 max-w-md mb-6">
            Um site de inventário logístico, pensado para simplificar o controle de produtos e estoques de forma
            eficiente e acessível.
        </p>
        <img src="/static/img/banner1.png" alt="Banner" class="w-4/5 max-w-lg rounded-lg mb-6 object-contain">
        <a href="/login"
            class="bg-red-600 hover:bg-red-700 text-white font-semibold py-3 px-6 rounded transition-colors">
            Fazer Login
        </a>
    </section>

    <!-- Footer -->
    <footer class="bg-blue-900 text-white text-center py-4 mt-auto">
        <p>&copy; 2025 Go Inventory. Todos os direitos reservados.</p>
    </footer>

</body>

</html>