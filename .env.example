
# Base configuration for the application
BASE_URL=http://localhost
PORT=8000

# Database configuration
DB_HOST=db
DB_PORT=3306
DB_NAME=inventory
DB_USER=root
DB_PASSWORD=root

# Storage configuration
# By default this example enables MinIO (local S3-compatible) settings.
# To use local filesystem storage, comment the MinIO block and uncomment the local block below.
STORAGE_PROVIDER=minio

# --- MinIO (S3-compatible) - active by default in this example ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=inventory
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# --- Local storage (filesystem) - example (commented) ---
#STORAGE_PROVIDER=local
#STORAGE_BASE_DIR=storage
#STORAGE_BASE_URL=http://localhost:3000/